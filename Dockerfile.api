FROM python:3.12-slim-trixie

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000

WORKDIR /app

COPY pyproject.toml requirements-api.txt ./

# Install scrapling deps only (no project source yet, for layer caching)
RUN uv sync --no-install-project --all-extras --compile-bytecode

COPY . .

# Install browsers + project + API server deps
RUN apt-get update && \
    uv run playwright install-deps chromium && \
    uv run playwright install chromium && \
    uv sync --all-extras --compile-bytecode && \
    uv pip install -r requirements-api.txt && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

EXPOSE 8000

CMD ["sh", "-c", "uv run uvicorn api_server:app --host 0.0.0.0 --port ${PORT:-8000}"]
